@page
@model API.Pages.ResetPasswordSucceededModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Success</title>
</head>
<body style="
    margin:0;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#f8fafc;
    font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
">

    <div style="
        background:#ffffff;
        padding:48px 56px;
        border-radius:14px;
        box-shadow:
            0 10px 30px rgba(0,0,0,0.06),
            0 0 0 2px rgba(34,197,94,0.15);
        text-align:center;
        max-width:520px;
        width:100%;
    ">
        <div style="
            width:72px;
            height:72px;
            margin:0 auto 20px auto;
            border-radius:50%;
            background:rgba(34,197,94,0.12);
            display:flex;
            align-items:center;
            justify-content:center;
            box-shadow:0 8px 20px rgba(34,197,94,0.25);
        ">
            <span style="
                font-size:38px;
                font-weight:600;
                color:#16a34a;
                line-height:1;
            ">
                ✓
            </span>
        </div>

        <h1 style="
            margin:0 0 12px 0;
            font-size:28px;
            font-weight:600;
            color:#0f172a;
        ">
            Done
        </h1>

        <p style="
            margin:0;
            font-size:16px;
            line-height:1.6;
            color:#475569;
        ">
            @Request.Query["Message"]"
        </p>

    </div>

</body>
</html>
