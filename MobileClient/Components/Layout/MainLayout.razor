@using Application.DTO
@using Microsoft.AspNetCore.SignalR.Client
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.SessionService
@using MobileClient.Helper
@using MobileClient.Components.Pages.Shared
@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IAsyncDisposable
@inject UserSessionService UserSessionService
@inject IAlertService AlertService
@inject IAccountService AccountService

<div class="page">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <_LoadingOverlay/>

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article style="margin-top: 56px;">
            @Body
        </article>
    </main>
</div>

@code{
    public static HubConnection? hubConnection;
    public static event Action? OnNewActivityReceived;

    protected override async Task OnInitializedAsync()
    {
        UserSessionService.OnUserBanned += HandleUserBannedAsync;

        string url = "http://192.168.100.19:4321/socialnetwork/activityhub";
        string url2 = "https://localhost:7098/activityhub";
        string url3 = "http://10.0.2.2:5209/activityhub";

        if (DeviceInfo.Platform == DevicePlatform.Android)
            url = "http://10.0.2.2:5209/activityhub";
        else
            url = "https://localhost:7098/activityhub";

        var test = await GetToken();
        hubConnection = new HubConnectionBuilder().WithUrl(NavManager.ToAbsoluteUri(url), async options =>
        {
            options.AccessTokenProvider = async () => await GetToken();
        }).WithAutomaticReconnect().Build();

        hubConnection.On("ReceiveActivityNotification", () =>
        {
            OnNewActivityReceived?.Invoke();
        });

        // hubConnection.On("RequestLocation", async () =>
        // {
        //     await SendMyLocationAsync();
        // });

        await hubConnection.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var status = await LocationHelper.GetLocationPermission();
        if (status == false)
        {

        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
        UserSessionService.OnUserBanned -= HandleUserBannedAsync;
    }

    private async Task<string> GetToken()
    {
        var token = await SecureStorage.GetAsync("accessToken");
        return token;
    }

    private async Task HandleUserBannedAsync()
    {
        await MainThread.InvokeOnMainThreadAsync(async () =>
        {
            await AlertService.ShowAlertAsync("Error", "Your account has been banned due to too many reports to your account. If you think this ban is unjustified, contact our admin", "OK");

            SecureStorage.Remove("accessToken");
            SecureStorage.Remove("refreshToken");

            NavManager.NavigateTo("/register", forceLoad: true);
        });
    }
}
