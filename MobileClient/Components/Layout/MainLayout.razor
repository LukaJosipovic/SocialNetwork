@code{
    public static HubConnection? hubConnection;
    public static event Action? OnNewActivityReceived;

    protected override async Task OnInitializedAsync()
    {
        UserSessionService.OnUserBanned += HandleUserBanned;
        string url = "http://192.168.100.4/socialnetwork/activityhub";
        string url2 = "https://localhost:7098/socialnetwork/activityhub";
        string url3 = "http://10.0.2.2:5209/socialnetwork/activityhub";
        var test = await GetToken();
        hubConnection = new HubConnectionBuilder().WithUrl(NavManager.ToAbsoluteUri(url), async options =>
        {
            options.AccessTokenProvider = async () => await GetToken();
        }).WithAutomaticReconnect().Build();

        hubConnection.On("ReceiveActivityNotification", () =>
        {
            OnNewActivityReceived?.Invoke();
        });

        // hubConnection.On("RequestLocation", async () =>
        // {
        //     await SendMyLocationAsync();
        // });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
        UserSessionService.OnUserBanned -= HandleUserBanned;
    }

    private async Task<string> GetToken()
    {
        var token = await SecureStorage.GetAsync("accessToken");
        return token;
    }

    private async void HandleUserBanned(string message)
    {
        // Clear tokens
        await SecureStorage.SetAsync("accessToken", "");
        await SecureStorage.SetAsync("refreshToken", "");
        await AlertService.ShowAlertAsync($"Account Banned", message, "OK");
        NavManager.NavigateTo("/login");
    }

