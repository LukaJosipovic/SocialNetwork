<style>
    .navbar-toggler {
    position: relative;
    }

    .has-new-activity::after {
    content: "";
    position: absolute;
    top: 4px;
    right: 4px;
    width: 10px;
    height: 10px;
    background-color: red;
    border-radius: 50%;
    z-index: 1001;
    }

</style>

<div class="top-row ps-3 navbar navbar-dark">
