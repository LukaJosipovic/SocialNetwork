@using MobileClient.Helper
@using MobileClient.Components.Pages.Shared
@using MobileClient.Services.App
@using MobileClient.Services.Connectivity
@inject NavigationManager NavManager
@inject IAppCloser AppCloser
@inherits LayoutComponentBase
@inject ConnectivityService ConnectivityService
@implements IAsyncDisposable

<div class="page">

    <_LoadingOverlay />

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code{
    protected override async Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;
        ConnectivityService.ConnectivityChanged += OnConnectivityChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ConnectivityService.UpdateLastKnownPage(e.Location);
    }


    private void OnConnectivityChanged(bool isConnected)
    {
        if (!isConnected)
        {
            MainThread.BeginInvokeOnMainThread(() =>
            {
                NavManager.NavigateTo("/nointernet", replace: true);
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        ConnectivityService.ConnectivityChanged -= OnConnectivityChanged;
    }
}