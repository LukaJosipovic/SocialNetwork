@inject IAccountService AccountService
@page "/myprofile"
@using Application.DTO.Request
@using Application.DTO.Response
@using Microsoft.AspNetCore.Components.Authorization
@using MobileClient.AuthStateProvider
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Components.Pages.Shared
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject IAccountService AccountService
@inject INotificationService NotificationService
@using MobileClient.Services.LoadingService
@using MobileClient.Services.Notification
@using Plugin.Firebase.CloudMessaging
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex justify-content-end">
    <div class="dropdown">
        <button class="btn btn-link p-0 m-0 border-0"
                type="button"
                id="iconMenuButton"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            <i class="bi bi-three-dots-vertical fs-4"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
            @if (!isAdmin)
            {
                
                <li><button class="dropdown-item" @onclick="NavigateToBlockedUsers">Blocked Users</button></li>
                <li><button class="dropdown-item" @onclick="DeleteAccount">Delete Profile</button></li>
            }
            <li><button class="dropdown-item" @onclick="Logout">Logout</button></li>
        </ul>
    </div>
</div>

@if (isSuccess)
{
    <div class="d-flex justify-content-center mt-3">
        <_Profile profile="@profile" />
    </div>
}

@code {
    private UserProfileRespons profile { get; set; } = new();
    private string? profileImage;
    private bool isSuccess;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.MyProfile();

        if (response.IsSuccess)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAdmin = authState.User.IsInRole("Admin");
            isSuccess = true;
            profile = response;
        }
        else
        {
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
        }

        LoadingService.IsLoading = false;
    }

    public async Task DeleteAccount()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.DeleteAccount();

        if (response.IsSuccess)
        {
            await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
            // SecureStorage.Remove("accessToken");
            // SecureStorage.Remove("refreshToken");
            // SecureStorage.Remove("userLocation");
            // NavManager.NavigateTo($"/register");
            LoadingService.IsLoading = false;
            await Logout();
        }
        else
        {
            LoadingService.IsLoading = false;
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
        }

        //LoadingService.IsLoading = false;
        //NavManager.NavigateTo($"/register");
    }

    private void NavigateToPostDetails(int postId)
    {
        NavManager.NavigateTo($"/profile/{postId}");
    }

    private void NavigateToBlockedUsers()
    {
        NavManager.NavigateTo($"/blockedusers");
    }

    private async Task Logout()
    {
        var refreshToken = await SecureStorage.GetAsync("refreshToken");
#if ANDROID
        await CrossFirebaseCloudMessaging.Current.CheckIfValidAsync();
        var token = await CrossFirebaseCloudMessaging.Current.GetTokenAsync();
        var logoutRequest = new LogoutRequest 
        { 
            DeviceToken = token,
            RefreshToken = refreshToken 
        };

        //var result = await NotificationService.DeactivateDevice(token);
        var result = await AccountService.Logout(logoutRequest);

        if (!result.IsSuccess)
            await AlertService.ShowAlertAsync("Error", $"{result.Message}", "OK");
#endif

        var authProvider = (CustomAuthStateProvider)AuthStateProvider;
        authProvider.NotifyUserLogout();
        NavManager.NavigateTo($"/register", replace: true);

    }
}
