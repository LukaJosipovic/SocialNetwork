@page "/friendrequests"
@using Application.DTO.Response
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject IAccountService AccountService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject LoadingService LoadingService

@if (friendRequests == null || !friendRequests.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people fs-1"></i>
        <p class="mt-2">No new friend requests</p>
    </div>
}

@if (friendRequests != null && friendRequests.Any())
{
    <div class="container py-2">
        @foreach (var friendRequest in friendRequests)
        {
            <div class="card mb-3">
                <div class="card-body pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            @if (friendRequest.ProfilePictureString != null)
                            {
                                <img src="@friendRequest.ProfilePictureString"
                                     class="rounded-circle me-2"
                                     style="width:48px; height:48px; object-fit:cover;"
                                     @onclick="() => NavigateToUserProfile(friendRequest.Id)" />

                                <span class="fw-semibold">
                                    @friendRequest.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <p class="mb-2 fs-6">@friendRequest.Description</p>
                    <div class="d-grid">
                        <button class="btn btn-primary" style="background-color: #512bdf;" @onclick="() => AcceptFriendship(friendRequest)">
                            Accept Friendship
                        </button>
                    </div>
                </div>

            </div>
        }
    </div>
}

@code {
    private List<FriendRequestDTO>? friendRequests;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.GetFriendRequests();
        friendRequests = response.FriendRequestDTOs;
        
        if (response.IsSuccess == false)
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");

        LoadingService.IsLoading = false;
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task AcceptFriendship(FriendRequestDTO friendRequest)
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.AcceptFriendship(friendRequest.Id, friendRequest.FriendRequestId);
        if (response.IsSuccess)
        {
            friendRequests.Remove(friendRequest);
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
            StateHasChanged();
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }

        LoadingService.IsLoading = false;
    }
}
