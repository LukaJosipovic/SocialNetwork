@inject IAccountService AccountService
@inject IAlertService AlertService
@page "/addpost"
@using Application.DTO.Request
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService

<div class="container py-3">

    <!-- Preview Image -->
    @if (!string.IsNullOrEmpty(ImagePreview))
    {
        <div class="card mb-3">
            <img src="@ImagePreview" class="card-img-top" style="max-height: 350px; object-fit: cover;" />
        </div>
    }

    <EditForm Model="@createPostRequest" OnValidSubmit="@CreatePost">
        <DataAnnotationsValidator />
        <!-- Image Picker -->
        <div class="card mb-3">
            <div class="card-body">
                <label class="form-label fw-semibold">Photo</label>
                <InputFile OnChange="LoadImage" accept="image/*" class="form-control" />
                <ValidationMessage For="() => createPostRequest.ImageData" class="text-danger" />
            </div>
        </div>

        <!-- Description -->
        <div class="card mb-3">
            <div class="card-body">
                <label class="form-label fw-semibold">Description</label>
                <InputTextArea class="form-control" rows="3" placeholder="Write something..." @bind-Value="createPostRequest.Description" />
            </div>
        </div>

        <!-- Submit Button -->
        <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg" style="background-color: #512bdf;">Upload Post</button>
        </div>

    </EditForm>

</div>

@code {
    private string? ImagePreview;
    private byte[]? buffer;
    private string? description;
    private CreatePostRequest createPostRequest { get; set; } = new();

    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024).ReadAsync(buffer);
            ImagePreview = $"data:image;base64,{Convert.ToBase64String(buffer)}";
            createPostRequest.ImageData = buffer;
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync($"Error", "Error loading image", "OK");
        }
    }

    private async Task CreatePost()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.CreatePost(createPostRequest);

        if (response.IsSuccess)
        {
            await AlertService.ShowAlertAsync($"Ok", "Post created successfully ", "OK");
        }

        LoadingService.IsLoading = false;
    }
}
