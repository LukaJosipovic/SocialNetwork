<div class="pt-4">
    <div class="input-group mb-3" style="width: 90%; margin: 0 auto;">
        <input type="text" value="@name" @oninput="OnSearchChange" class="form-control" placeholder="email">
    </div>
</div>

<div id="chatContainer" class="container py-2 overflow-auto" style="height: 89vh; margin-top: 20px;">
    @if (conversations.Count > 0)
    {
        @foreach (var conversation in conversations)
        {
            <div class="card mb-2 @(conversation.HasUnreadMessages ? "border-primary bg-light" : "")">
                <div class="card-body py-2">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center flex-grow-1"
                             @onclick="() => NavigateToChat(conversation.UserId, conversation.ConversationId)"
                             style="cursor:pointer;">

                            @if (conversation.ProfilePictureString != null)
                            {
                                <img src="@conversation.ProfilePictureString"
                                     class="rounded-circle me-3"
                                     style="width:48px; height:48px; object-fit:cover;"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => NavigateToUserProfile(conversation.UserId)" />
                            }

                            <div>
                                <div class="fw-semibold">
                                    @conversation.Name
                                </div>
                                <small class="text-muted">
                                    Tap to open chat
                                </small>
                            </div>
                        </div>

                        @if (conversation.IsBlocked)
                        {
                            <span class="badge bg-secondary">Blocked</span>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm ms-2"
                                    @onclick="() => BlockUser(conversation.UserId)">
                                <i class="bi bi-ban"></i>
                            </button>
                        }

                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-chat-dots fs-1"></i>
            <p class="mt-2 mb-0">There is no one to chat with</p>
        </div>
    }
</div>


@code {
    private List<ConversationDTO> conversations = new();
    //My Id
    private string? senderId;
    private string? recipientId;
    private string? name;
    private PageSettingsRequest pageSettings = new();
    private bool hasMoreData = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollEnd", "chatContainer", "LoadMoreUsers", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            if (!hasMoreData) 
                return;

            var response = await ChatService.GetChatRooms(pageSettings);
            if (response.ConversationList != null && response.ConversationList.Any())
            {
                // foreach (var user in response.UsersChatList)
                // {
                //     if (user.ProfilePicture != null)
                //     {
                //         user.ProfilePictureString = $"data:image;base64,{Convert.ToBase64String(user.ProfilePicture)}";
                //     }
                // }
                conversations.AddRange(response.ConversationList);
                senderId = response.MyId;
                pageSettings.PageNumber++;
            }
            else if (response.IsSuccess == false)
            {
                await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
            }
            else
            {
                //users = null;
                hasMoreData = false;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            return;
        }
    }

    [JSInvokable]
    public async Task LoadMoreUsers()
    {
        await LoadUsers();
    }

    private void NavigateToChat(string RecipientId, int conversationId)
    {
        NavManager.NavigateTo($"/chat/{senderId}/{RecipientId}/{conversationId.ToString()}");
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task BlockUser(string userId)
    {
        var response = await AccountService.BlockUser(userId);

        if (response.IsSuccess)
        {
            var conversation = conversations.FirstOrDefault(c => c.UserId == userId);

            if (conversation != null)
                conversation.IsBlocked = true;

            await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
            StateHasChanged();
        }
        else
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
    }

    private async Task OnSearchChange(ChangeEventArgs e)
    {
        name = e.Value?.ToString();

        try
        {
            await Task.Delay(500); // 500ms debounce
            await StartSearch();
        }
        catch (TaskCanceledException)
        {
            // ignore
        }
    }

    private async Task StartSearch()
    {
        pageSettings.PageNumber = 1;
        conversations.Clear();
        hasMoreData = true;

        pageSettings.SearchTerm = name;

        if (string.IsNullOrWhiteSpace(name))
            pageSettings.SearchTerm = null;

        await LoadUsers();
    }
}
