@page "/chatrooms"
@using Application.DTO
@using Application.DTO.Request
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.Chat
@inject IChatService ChatService
@inject IAccountService AccountService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IAlertService AlertService

<h3>ChatRooms</h3>

<div id="chatContainer" style="height: 500px; overflow-y: auto; border: 1px solid">
    @if (users.Count > 0)
    {
        @foreach (var user in users)
        {
            <hr />
            <div>
                @if (user.ProfilePictureString != null)
                {
                    <div>
                        <img src="@user.ProfilePictureString" alt="Profile picture" style="width: 50px; height: 50px;" class="me-2 rounded-circle" @onclick="() => NavigateToUserProfile(user.Id)" />
                        <p class="mb-0" @onclick="() => NavigateToChat(user.Id)">@user.Name</p>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-danger" @onclick="() => BlockUser(user.Id)">
                            <i class="bi bi-ban"></i> Block
                        </button>
                    </div>
                }
            </div>
        }
        @if (isLoading)
        {
            <p>Loading more...</p>
        }
    }
    else
    {
        <p>There is no people to chat</p>
    }
</div>

@code {
    private List<UserBriefDetailsDTO>? users = new();
    //My Id
    private string? senderId;
    private string? recipientId;
    private PageSettingsRequest pageSettings = new();
    private bool isLoading = false;
    private bool hasMoreData = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollEnd", "chatContainer", "LoadMoreUsers", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadUsers()
    {
        if (isLoading || !hasMoreData) 
            return;

        isLoading = true;

        var response = await ChatService.GetChatRooms(pageSettings);
        if (response.UsersChatList != null && response.UsersChatList.Any())
        {
            foreach (var user in response.UsersChatList)
            {
                if (user.ProfilePicture != null)
                {
                    user.ProfilePictureString = $"data:image;base64,{Convert.ToBase64String(user.ProfilePicture)}";
                }
            }
            users.AddRange(response.UsersChatList);
            senderId = response.MyId;
            pageSettings.PageNumber++;
        }
        else
        {
            //users = null;
            hasMoreData = false;
        }
        isLoading = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task LoadMoreUsers()
    {
        await LoadUsers();
    }

    private void NavigateToChat(string RecipientId)
    {
        NavManager.NavigateTo($"/chat/{senderId}/{RecipientId}");
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task BlockUser(string userId)
    {
        var response = await AccountService.BlockUser(userId);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
    }
}
