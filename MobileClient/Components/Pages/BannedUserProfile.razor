@page "/bannedprofile/user/{UserId}"
@using Application.DTO.Response
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.Post
@using MobileClient.Components.Pages.Shared
@inject IPostService PostService
@inject IAccountService AccountService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService
@inject IAlertService AlertService

<div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <h3>@profile.Name</h3>
    </div>
    <div class="dropdown">
        <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
                data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
            <li><button class="dropdown-item" @onclick="() => UnbanUser(UserId)">Unbann</button></li>
            @* <li><button class="dropdown-item" @onclick="() => DeleteUser(UserId)">Delete</button></li> *@
        </ul>
    </div>
</div>

@if (IsSuccess)
{
    <_Profile profile="@profile" />
}

@code {
    [Parameter]
    public string UserId { get; set; }
    private UserProfileRespons profile { get; set; } = new();
    private string? profileImage;
    private bool IsSuccess;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.GetBannedProfile(UserId);

        if (response.IsSuccess)
        {
            IsSuccess = response.IsSuccess;
            profile = response;
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }

        LoadingService.IsLoading = false;
    }

    private async Task UnbanUser(string userId)
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.UnbanUser(userId);
        if (response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");

        LoadingService.IsLoading = false;
    }

    // private async Task DeleteUser(string userId)
    // {
        
    // }

}
