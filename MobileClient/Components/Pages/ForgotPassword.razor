@page "/forgotpassword"
@using Application.DTO.Request
@using MobileClient.Services.Alert
@using MobileClient.Services.Auth
@inject IAuthService AuthService
@inject IAlertService AlertService
@inject NavigationManager NavManager


<div class="d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 3.5rem);">
    <div style="width: 80%;">
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-shield-lock" style="font-size: 3rem; color: #512bdf;"></i>
            </div>

            <h2 class="fw-bold mb-2">Forgot Password?</h2>

            <p class="text-muted mb-0">
                Enter your email address and we'll send you a link to reset your password.
            </p>
        </div>
        <EditForm method="post" Model="Request" OnValidSubmit="SubmitEmail" FormName="register" Enhance>
            <DataAnnotationsValidator />
            <div data-mdb-input-init class="form-outline mb-4">
                <input type="email" @bind-value="Request.Email" id="emailInput" placeholder="Enter your email address" class="form-control" />
                <ValidationMessage For="() => Request.Email" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary" style="background-color: #512bdf; width: 100%">Submit</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotUserPasswordRequest Request { get; set; } = new();

    private async Task SubmitEmail()
    {
        var result = await AuthService.ForgotPassword(Request);
        if (result.IsSuccess)
        {
            await AlertService.ShowAlertAsync($"Success", $"{result.Message}", "OK");
            NavManager.NavigateTo("/login");
        }else
        {
            await AlertService.ShowAlertAsync($"Error", $"{result.Message}", "OK");
        }
    }
}
