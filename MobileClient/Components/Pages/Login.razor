@page "/login"
@using Application.DTO.Request
@using MobileClient.BackgroundTask.Location
@using MobileClient.Services.Alert
@using MobileClient.Services.Auth
@using MobileClient.Services.Notification
@using Plugin.Firebase.CloudMessaging
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject ILocationTracker LocationTracker
@inject INotificationService NotificationService
@inject IAlertService AlertService
@layout MobileClient.Components.Layout.EmptyLayout
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService

<div class="d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 3.5rem);">
    <div style="width: 80%;">
        <EditForm method="post" Model="Request" OnValidSubmit="LoginUser" FormName="register" Enhance>
            <DataAnnotationsValidator />
            <div data-mdb-input-init class="form-outline mb-4">
                <input type="email" @bind-value="Request.Email" id="emailInput" placeholder="Email address" class="form-control" />
                <ValidationMessage For="() => Request.Email" class="text-danger" />
            </div>

            <div data-mdb-input-init class="form-outline mb-4">
                <input type="password" @bind-value="Request.Password" id="passwordInput" placeholder="Password" class="form-control" />
                <ValidationMessage For="() => Request.Password" class="text-danger" />
            </div>

            <div class="d-flex align-items-center justify-content-between">
                <button type="submit" class="btn btn-primary" style="background-color: #512bdf; width: 30%">Sign in</button>
                <button type="button" @onclick="ForgotPasswordClicked" class="btn btn-link p-0" style="font-size:1rem; color:#0000EE; cursor:pointer; text-decoration:none;">
                    Forgot password
                </button>
            </div>
            @* <button type="submit" class="btn btn-primary" style="background-color: #512bdf; width: 30%">Sign in</button>
            <button type="button" @onclick="ForgotPasswordClicked" style="float:right; background:none; border:none; color:#0000EE; cursor:pointer; padding:0; font-size:1rem;">
                Forgot password
            </button> *@
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginUserRequest Request { get; set; } = new()
    {
        Email = "string@string.com",
        Password = "Pa$$w0rd"
    };

    private async Task LoginUser()
    {
        LoadingService.IsLoading = true;

        var result = await AuthService.Login(Request);
        if (result.IsSuccess)
        {
            await SecureStorage.SetAsync("accessToken", result.AccessToken);
            await SecureStorage.SetAsync("refreshToken", result.RefreshToken);
            SendNotificationToken();
            //var test = await AuthService.Test();
            //await LocationTracker.StartAsync();
            NavManager.NavigateTo("/home");
        }
        else
        {
            await AlertService.ShowAlertAsync($"Error", $"{result.Message}", "OK");
        }

        LoadingService.IsLoading = false;
    }

    private async Task ForgotPasswordClicked()
    {
        NavManager.NavigateTo("/forgotpassword");
    }

    private async void SendNotificationToken()
    {
        #if ANDROID
        await CrossFirebaseCloudMessaging.Current.CheckIfValidAsync();
        var token = await CrossFirebaseCloudMessaging.Current.GetTokenAsync();

        var result = await NotificationService.RegisterDevice(token);

        if(!result.IsSuccess)
        {
            await AlertService.ShowAlertAsync("Error", $"{result.Message}", "OK");
        }

        // await Share.RequestAsync(new ShareTextRequest
        // {
        //     Text = token,
        //     Title = "Share Firebase Token"
        // });
        #endif
    }
}
