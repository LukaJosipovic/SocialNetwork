@page "/activities"
@using Application.DTO.Response
@using MobileClient.Services.Activity
@using MobileClient.Services.Alert
@inject IActivityService ActivityService
@inject NavigationManager NavManager
@inject IAlertService AlertService

<h3>Activities</h3>

@if (activities != null)
{
    foreach (var activity in activities)
    {
        <hr />
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                @if (activity.User.ProfilePictureString != null)
                {
                    <img src="@activity.User.ProfilePictureString" alt="Profile picture"
                         style="width: 50px; height: 50px;" class="me-2 rounded-circle" @onclick="() => NavigateToUserProfile(activity.User.Id)" />
                    <p class="mb-0">@activity.User.Name</p>
                }
            </div>

            <div class="dropdown">
                <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical fs-4"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
                    <li><button class="dropdown-item" @onclick="() => ReportActivity(activity.CacheKey)">Report</button></li>
                </ul>
            </div>
        </div>
        <div>
            <h4>@activity.Description</h4>
            <h4>Category: @activity.ActivityCategory</h4>
            <button class="btn btn-primary" style="background-color: #512bdf; float:right" @onclick="() => AcceptActivity(activity.CacheKey)">Accept</button>
        </div>
    }
}

@code {
    private List<ActivityResponse>? activities;

    protected override async Task OnInitializedAsync()
    {
        var response = await ActivityService.GetActivities();
        if (response.Count > 0)
        {
            foreach (var activity in response)
            {
                if (activity.User.ProfilePicture != null)
                {
                    activity.User.ProfilePictureString = $"data:image;base64,{Convert.ToBase64String(activity.User.ProfilePicture)}";
                }
            }
            activities = response;
        }else
        {
            activities = null;
        }
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task ReportActivity(string cacheKey)
    {
        var response = await ActivityService.ReportActivity(cacheKey);
        if (response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    }

    private async Task AcceptActivity(string cacheKey)
    {
        var response = await ActivityService.AcceptActivity(cacheKey);
        if (response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    }
}
