@page "/activities"
@using Application.DTO.Response
@using Application.Exceptions
@using MobileClient.Services.Activity
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject IActivityService ActivityService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject LoadingService LoadingService

@if (activities == null || !activities.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x fs-1"></i>
        <p class="mt-2">No activities available</p>
    </div>
}

@if (activities != null)
{
    <div class="container py-2">
        @foreach (var activity in activities)
        {
            <div class="card mb-3">
                <!-- Header -->
                <div class="card-body pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            @if (activity.User.ProfilePictureString != null)
                            {
                                <img src="@activity.User.ProfilePictureString"
                                     class="rounded-circle me-2"
                                     style="width:48px; height:48px; object-fit:cover;"
                                     @onclick="() => NavigateToUserProfile(activity.User.Id)" />

                                <span class="fw-semibold">
                                    @activity.User.Name
                                </span>
                            }
                        </div>
                        <!-- Menu -->
                        @* <div class="dropdown">
                            <button class="btn btn-link p-0 text-body"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-5"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button class="dropdown-item"
                                            @onclick="() => ReportActivity(activity.CacheKey)">
                                        Report
                                    </button>
                                </li>
                            </ul>
                        </div> *@
                    </div>
                </div>

                <!-- Content -->
                <div class="card-body pt-0">
                    <p class="mb-2 fs-6">@activity.Description</p>
                    <span class="badge bg-secondary mb-3">@activity.ActivityCategory</span>
                    <div class="d-grid">
                        <button class="btn btn-primary" style="background-color: #512bdf;" @onclick="() => AcceptActivity(activity.CacheKey)">
                            Accept Activity
                        </button>
                    </div>
                </div>

            </div>
        }
    </div>
}

@code {
    private List<ActivityResponse>? activities;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        try
        {
            var response = await ActivityService.GetActivities();
            if (response.Count > 0)
            {
                foreach (var activity in response)
                {
                    if (activity.User.ProfilePicture != null)
                    {
                        activity.User.ProfilePictureString = $"data:image;base64,{Convert.ToBase64String(activity.User.ProfilePicture)}";
                    }
                }
                activities = response;
            }
            else
            {
                activities = null;
            }
        }
        catch (AccountBannedException ex)
        {
            await AlertService.ShowAlertAsync("Error", $"{ex.Message}", "OK");
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", "Something went wrong", "OK");
        }

        LoadingService.IsLoading = false;
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    // private async Task ReportActivity(string cacheKey)
    // {
    //     var response = await ActivityService.ReportActivity(cacheKey);
    //     if (response.IsSuccess)
    //         await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
    //     else
    //         await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    // }

    private async Task AcceptActivity(string cacheKey)
    {
        LoadingService.IsLoading = true;

        var response = await ActivityService.AcceptActivity(cacheKey);
        if (response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");

        LoadingService.IsLoading = false;
    }
}
