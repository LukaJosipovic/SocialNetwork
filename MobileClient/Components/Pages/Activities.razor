@page "/activities"
@using Application.DTO.Response
@using Application.Exceptions
@using Microsoft.AspNetCore.Components.Authorization
@using MobileClient.Services.Activity
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject IActivityService ActivityService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthStateProvider

@if (activities == null || !activities.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x fs-1"></i>
        <p class="mt-2">No activities available</p>
    </div>
}

@if (activities != null && activities.Any())
{
    <div class="container py-2">
        @foreach (var activity in activities)
        {
            <div class="card mb-3" @key="activity.CacheKey">
                <div class="card-body pb-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            @if (activity.User.ProfilePictureString != null)
                            {
                                <img src="@activity.User.ProfilePictureString"
                                     class="rounded-circle me-2"
                                     style="width:48px; height:48px; object-fit:cover;"
                                     @onclick="() => NavigateToUserProfile(activity.User.Id)" />

                                <span class="fw-semibold">
                                    @activity.User.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body pt-0">
                    <p class="mb-2 fs-6">@activity.Description</p>
                    <span class="badge bg-secondary mb-3">@activity.ActivityCategory</span>
                    <div class="d-grid">
                        @if (!isAdmin)
                        {
                            <button class="btn btn-primary" style="background-color: #512bdf;" @onclick="() => AcceptActivity(activity)">
                                Accept Activity
                            </button>
                        }
                    </div>
                </div>

            </div>
        }
    </div>
}

@code {
    private List<ActivityDTO>? activities;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await ActivityService.GetActivities();
        activities = response.Activities;
        
        if (response.IsSuccess == false)
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        LoadingService.IsLoading = false;
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task AcceptActivity(ActivityDTO activity)
    {
        LoadingService.IsLoading = true;

        var response = await ActivityService.AcceptActivity(activity.CacheKey);
        if (response.IsSuccess)
        {
            activities.Remove(activity);
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
            StateHasChanged();
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }

        LoadingService.IsLoading = false;
    }
}
