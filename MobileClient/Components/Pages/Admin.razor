<div class="container py-4">
    <div class="card mb-3">
        <div class="card-body">
            <button type="button" class="btn btn-primary btn-lg w-100" style="background-color: #512bdf;" @onclick="AddAdminForm">
                <i class="bi bi-person-plus me-2"></i> Add Admin
            </button>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <button type="button" class="btn btn-primary btn-lg w-100" style="background-color: #512bdf;" @onclick="DeletePostAdmin">
                Delete Posts
            </button>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <button type="button" class="btn btn-primary btn-lg w-100" style="background-color: #512bdf;" @onclick="ShowBannedAccounts">
                Show Banned Accounts
            </button>
        </div>
    </div>
</div>

@code {
    private async Task AddAdminForm()
    {
        NavManager.NavigateTo("/addadmin");
    }
    
    private async Task DeletePostAdmin()
    {
        NavManager.NavigateTo("/deletepostadmin");
    }
    
    private async Task ShowBannedAccounts()
    {
        NavManager.NavigateTo("/bannedaccounts");
    }
}
