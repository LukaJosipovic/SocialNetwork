@page "/deletepostadmin"
@using Application.DTO.Response
@using MobileClient.Services.Post
@using MobileClient.Services.Alert
@inject IPostService PostService
@inject IAlertService AlertService
@inject NavigationManager NavManager

@if (postsDetails == null || !postsDetails.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x fs-1"></i>
        <p class="mt-2">There are currently no posts</p>
    </div>
}
else
{
    foreach (var post in postsDetails)
    {
        <hr />
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                @if (post.User.ProfilePictureString != null)
                {
                    <img src="@post.User.ProfilePictureString" alt="Profile picture"
                    style="width: 50px; height: 50px;" class="me-2 rounded-circle" />
                    <p class="mb-0">@post.User.Name</p>
                }
            </div>

            <div class="dropdown">
                <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
                data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-three-dots-vertical fs-4"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
                    <li><button class="dropdown-item" @onclick="() => DeletePost(post.PostId)">Delete</button></li>
                    <li><button class="dropdown-item" @onclick="() => RemoveReport(post.PostId)">Remove Report</button></li>
                </ul>
            </div>
        </div>
        <div>
            @if (post.PostImageString != null)
            {
                <img src="@post.PostImageString" alt="Post picture" style="width: 100%;" />
            }
            <p>@post.DateCreated.ToString("MM.dd.yyyy")</p>
            <p>@post.Description</p>
        </div>
        <hr />
    }
}

@code {
    private List<PostDetailsResponse>? postsDetails;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await PostService.GetReportedPosts();
            if (response.Count > 0)
            {
                foreach (var post in response)
                {
                    //prebaciti u service
                    if (post.User.ProfilePicture != null)
                        post.User.ProfilePictureString = $"data:image;base64,{Convert.ToBase64String(post.User.ProfilePicture)}";

                }
                postsDetails = response;
            }
            else
            {
                postsDetails = null;
            }
        }
        catch (Exception)
        {
            await AlertService.ShowAlertAsync("Ok", "Something went wrong", "OK");
        }
    }

    private async Task DeletePost(int postId)
    {
        var response = await PostService.DeletePostAdmin(postId);
        if (response.IsSuccess)
        {   
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
            NavManager.NavigateTo("/deletepostadmin", forceLoad: true);
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
    }

    private async Task RemoveReport(int postId)
    {
        var response = await PostService.RemoveReport(postId);
        if (response.IsSuccess)
        {   
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
            NavManager.NavigateTo("/deletepostadmin", forceLoad: true);
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
    }
}
