@page "/profile/user/{UserId}"
@using Application.DTO.Response
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.Post
@inject IPostService PostService
@inject IAccountService AccountService
@inject NavigationManager NavManager
@inject IAlertService AlertService

<div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        <h3>@profile.Name</h3>
    </div>
    <div class="dropdown">
        <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
        data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-three-dots-vertical fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
            <li><button class="dropdown-item" @onclick="() => ReportUser(UserId)">Report</button></li>
        </ul>
    </div>
</div>
@if (!string.IsNullOrEmpty(profileImage))
{
    <img src="@profileImage" alt="Profile picture" style="width: 150px; height: 150px;" class="me-2 rounded-circle" />
}
<p>@profile.Description</p>

@if (profile.PostDTO != null && profile.PostDTO.Count > 0)
{
    foreach (var post in profile.PostDTO)
    {
        <img src="@post.ImageUrl" alt="Post picture" style="width: 100%; cursor: pointer;" @onclick="() => NavigateToPostDetails(post.PostID)" />
    }
}

@code {
    [Parameter]
    public string UserId { get; set; }
    private UserProfileRespons profile { get; set; } = new();
    private string? profileImage;

    protected override async Task OnInitializedAsync()
    {
        var response = await AccountService.GetUserProfile(UserId);

        if (response.IsSuccess)
        {
            if (response.ProfilePicture != null)
                profileImage = $"data:image;base64,{Convert.ToBase64String(response.ProfilePicture)}";

            profile = response;
        }

    }

    private async Task ReportUser(string userId)
    {
        var response = await AccountService.ReportUser(userId);
        if (response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    }

    private void NavigateToPostDetails(int postId)
    {
        NavManager.NavigateTo($"/profile/{postId}");
    }
}
