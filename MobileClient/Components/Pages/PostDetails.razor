@page "/profile/{PostId:int}"
@using Application.DTO.Response
@using Microsoft.AspNetCore.Components.Authorization
@using MobileClient.Services.Alert
@using MobileClient.Services.Post
@inject IPostService PostService
@inject NavigationManager NavManager
@using MobileClient.Services.LoadingService
@using System.Security.Claims
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAlertService AlertService

@if (postDetails != null)
{
    <div>
        <div class="d-flex justify-content-between align-items-center" style="padding: 0px 5px 0px 5px;">
            <div class="d-flex align-items-center" style="padding: 10px 5px 10px 5px;" @onclick="() => NavigateToUserProfile(postDetails.User.Id)">
                <img src="@postDetails.User.ProfilePictureString" alt="Profile picture" style="width: 50px; height: 50px;" class="me-2 rounded-circle" />
                <p class="mb-0" style="cursor: default;">@postDetails.User.Name</p>
            </div>

            @if (currentUserId == postDetails.User.Id)
            {
                <div class="d-flex justify-content-end">
                    <div class="dropdown">
                        <button class="btn btn-link p-0 m-0 border-0"
                                type="button"
                                id="iconMenuButton"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-three-dots-vertical fs-4"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
                            <li><button class="dropdown-item" @onclick="() => DeletePost(postDetails.PostId)">DeletePost</button></li>
                        </ul>
                    </div>
                </div>
            }
        </div>

        <img src="@postDetails.PostImageString" alt="Post picture" style="width: 100%;" />        
        <div class="post-container" style="padding: 5px 5px 5px 5px;">
            <div class="post-header" style="display: flex; align-items: center; justify-content: space-between;">
                <div class="like-section" style="display: flex; align-items: center;">
                    @if (postDetails.IsLiked)
                    {
                        <i class="bi bi-suit-heart-fill like-icon" style="font-size: 30px; color: red;" @onclick="() => DislikePost(postDetails.PostId)"></i>
                    }
                    else
                    {
                        <i class="bi bi-suit-heart like-icon" style="font-size: 30px; color: red;" @onclick="() => LikePost(postDetails.PostId)"></i>
                    }
                    <span class="like-count" style="margin-left: 10px; font-weight: bold;">@postDetails.LikeCount</span>
                </div>
                <span class="post-date" style="white-space: nowrap;">@postDetails.DateCreated.ToString("MM.dd.yyyy")</span>
            </div>

            <div class="post-description" style="margin-top: 8px;">
                @postDetails.Description
            </div>
        </div>
    </div>

@*     <img src="@postDetails.PostImageString" alt="Post picture" style="width: 100%;" />
    <p>@postDetails.Description</p>
    <div style="padding: 0px 5px 10px 5px; text-align: right;">
        <p>@postDetails.DateCreated.ToString("MM.dd.yyyy")</p>
    </div> *@
}

@code {
    [Parameter]
    public int PostId { get; set; }
    private PostDetailsDTO? postDetails;
    private string? profileImage;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await PostService.GetPostById(PostId);
        if (response.IsSuccess)
        {
            postDetails = response;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }


        LoadingService.IsLoading = false;
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task DeletePost(int postId)
    {
        var response = await PostService.DeletePost(postId);
        if (response.IsSuccess)
            NavManager.NavigateTo($"/myprofile");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    }
    private async Task LikePost(int postId)
    {
        var response = await PostService.LikePost(postId);
        if (response.IsSuccess)
        {
            postDetails.LikeCount = response.LikeCount;
            postDetails.IsLiked = true;
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
        StateHasChanged();
    }

    private async Task DislikePost(int postId)
    {
        var response = await PostService.DislikePost(postId);
        if (response.IsSuccess)
        {
            postDetails.LikeCount = response.LikeCount;
            postDetails.IsLiked = false;
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
        StateHasChanged();
    }
}
