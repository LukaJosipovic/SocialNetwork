@page "/home"
@using Application.DTO.Request
@using Application.DTO.Response
@using Application.Exceptions
@using Microsoft.AspNetCore.Components.Authorization
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@using MobileClient.Services.Post
@using System.Security.Claims
@inject IPostService PostService
@inject IAlertService AlertService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthStateProvider

<div id="postContainer" class="py-2 overflow-auto" style="height: 95vh; margin-top: 20px;">
    @if (postsDetails != null && postsDetails.Any())
    {
        foreach (var post in postsDetails)
        {
            <div style="margin-bottom: 10px;">
                <div class="d-flex justify-content-between align-items-center" style="padding: 0px 5px 10px 5px;">
                    <div class="d-flex align-items-center" @onclick="() => NavigateToUserProfile(post.User.Id)">
                        @if (post.User.ProfilePictureString != null)
                        {
                            <img src="@post.User.ProfilePictureString" alt="Profile picture"
                                 style="width: 50px; height: 50px;" class="me-2 rounded-circle" />
                            <p class="mb-0" style="cursor: default;">@post.User.Name</p>
                        }
                    </div>
                    @if (currentUserId != post.User.Id)
                    {
                        <div class="dropdown">
                            <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-4"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
                                <li><button class="dropdown-item" @onclick="() => ReportPost(post.PostId)">Report</button></li>
                            </ul>
                        </div>
                    }
                </div>
                @if (post.PostImageString != null)
                {
                    <img src="@post.PostImageString" alt="Post picture" style="width: 100%;" />
                }
                <div class="post-container" style="padding: 5px 5px 5px 5px;">
                    <div class="post-header" style="display: flex; align-items: center; justify-content: space-between;">
                        <div class="like-section" style="display: flex; align-items: center;">
                            @if (post.IsLiked)
                            {
                                <i class="bi bi-suit-heart-fill like-icon" style="font-size: 30px; color: red;" @onclick="() => DislikePost(post.PostId)"></i>
                            }
                            else
                            {
                                <i class="bi bi-suit-heart like-icon" style="font-size: 30px; color: red;" @onclick="() => LikePost(post.PostId)"></i>
                            }
                            <span class="like-count" style="margin-left: 10px; font-weight: bold;">@post.LikeCount</span>
                        </div>
                        <span class="post-date" style="white-space: nowrap;">@post.DateCreated.ToString("MM.dd.yyyy")</span>
                    </div>

                    <div class="post-description" style="margin-top: 8px;">
                        @post.Description
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1"></i>
            <p class="mt-2">There are currently no posts</p>
        </div>
    }
</div>

@code{
    private List<PostDetailsDTO>? postsDetails = new();
    private LikeResponse? likeResponse;
    private PageSettingsRequest pageSettings = new();
    private bool isLoading = true;
    private bool hasMoreData = true;
    private bool isFetchingPosts = false;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        pageSettings.PageSize = 2;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadPosts();

        LoadingService.IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollEnd", "postContainer", "LoadMorePosts", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadPosts()
    {
        if (!hasMoreData || isFetchingPosts)
            return;

        isFetchingPosts = true;

        var response = await PostService.GetAllPosts(pageSettings);
        if (response.PostDetails != null && response.PostDetails.Any())
        {
            postsDetails.AddRange(response.PostDetails);
            pageSettings.PageNumber++;
        }
        else if (response.IsSuccess == false)
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");    
        }
        else
        {
            hasMoreData = false;
        }
        isFetchingPosts = false;
        StateHasChanged(); 
    }

    [JSInvokable]
    public async Task LoadMorePosts()
    {
        await LoadPosts();
    }

    private async Task ReportPost(int postId)
    {
        var response = await PostService.ReportPost(postId);
        if(response.IsSuccess)
            await AlertService.ShowAlertAsync("Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
    }

    private async Task LikePost(int postId)
    {
        var response = await PostService.LikePost(postId);
        if (response.IsSuccess)
        {
            var post = postsDetails.FirstOrDefault(p => p.PostId == response.PostId);
            post.LikeCount = response.LikeCount;
            post.IsLiked = true;
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
        StateHasChanged();
    }

    private async Task DislikePost(int postId)
    {
        var response = await PostService.DislikePost(postId);
        if (response.IsSuccess)
        {
            var post = postsDetails.FirstOrDefault(p => p.PostId == response.PostId);
            post.LikeCount = response.LikeCount;
            post.IsLiked = false;
        }
        else
        {
            await AlertService.ShowAlertAsync("Error", $"{response.Message}", "OK");
        }
        StateHasChanged();
    }

    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }
}