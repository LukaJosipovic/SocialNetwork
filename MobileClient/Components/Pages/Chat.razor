@page "/chat/{senderId}/{recipientId}/{conversationId}"
@using Application.DTO
@using Application.DTO.Response
@using Microsoft.AspNetCore.SignalR.Client
@using MobileClient.Services.Alert
@using MobileClient.Services.Chat
@using MobileClient.Services.LoadingService
@inject IJSRuntime JS
@inject IChatService ChatService
@inject NavigationManager NavManager
@implements IAsyncDisposable
@inject IAlertService AlertService
@inject LoadingService LoadingService
@layout MobileClient.Components.Layout.ChatLayout

<nav class="navbar fixed-top navbar-light bg-light">
    <div class="container-fluid">
        <div class="d-flex align-items-center">
            @if (IsSuccess)
            {
                <span class="bi bi-arrow-left fs-3" @onclick="NavigateToChatRooms"></span>
                <img src="@messageFromUser.ProfilePictureString" alt="Profile picture" style="width: 50px; height: 50px;" class="me-2 rounded-circle" @onclick="() => NavigateToUserProfile(messageFromUser.Id)" />
                <p class="mb-0" style="cursor: default;">@messageFromUser.Name</p>
            }
        </div>
    </div>
</nav>

<div class="vh-100 d-flex flex-column">
    <div id="chatContainer" class="flex-grow-1 w-100 overflow-auto p-3 bg-light pb-5">
        @foreach (var message in messageFromUser.MessagesDto)
        {
            if (message.UserId == senderId)
            {
                <div class="d-flex mb-2">
                    <div style="background-color: #512bdf; color: white" class="d-inline-block p-2 rounded shadow-sm w-auto ms-auto">
                        @message.Content
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex mb-2">
                    <div class="d-inline-block p-2 rounded bg-white shadow-sm w-auto">
                        @message.Content
                    </div>
                </div>
            }
        }
    </div>

    @if (!conversationBlocked)
    {
        <div class="fixed-bottom bg-light p-2">
            <div class="input-group">
                <input class="form-control"
                       placeholder="Type a message..."
                       @bind="messageInput" />

                <button class="btn btn-primary"
                        @onclick="Send"
                        disabled="@(IsConnected == false)">
                    Send
                </button>
            </div>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<string> messages = new();
    private UserBriefDetailsDTO userToChat = new();
    private MessageResponse messageFromUser = new();
    private string? userInput;
    private string? messageInput;
    private bool conversationBlocked;
    private bool IsSuccess;
    [Parameter]
    public string? senderId { get; set; }
    [Parameter]
    public string? recipientId { get; set; }
    [Parameter]
    public string? conversationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LoadingService.IsLoading = true;

            var messageRespons = await ChatService.GetMessages(recipientId, int.Parse(conversationId));
            if (messageRespons.IsSuccess)
            {
                IsSuccess = messageRespons.IsSuccess;

                messageFromUser = messageRespons;
                userToChat.Name = messageRespons.Name;
                userToChat.ProfilePictureString = messageRespons.ProfilePictureString;

                conversationBlocked = messageRespons.ConversationBlocked;
                var oldMessages = messageRespons.MessagesDto;

                foreach (var message in oldMessages)
                {
                    messages.Add(message.Content);
                }

                var url1 = "http://192.168.100.19:4321/socialnetwork/chathub";
                var url2 = "";
                if (DeviceInfo.Platform == DevicePlatform.Android)
                    url2 = "http://10.0.2.2:5209/chathub";
                else
                    url2 = "https://localhost:7098/chathub";

                hubConnection = new HubConnectionBuilder().WithUrl(NavManager.ToAbsoluteUri(url2), async options =>
                {
                    options.AccessTokenProvider = async() => await GetToken();
                }).WithAutomaticReconnect().Build();

                hubConnection.On<string, string>("ReceiveClientMessage", (senderId, message) =>
                {
                    //var formattedMessage = $"From {senderId}: {message}";
                    //var formattedMessage = $"{message}";
                    //messages.Add(message);
                    messageFromUser.MessagesDto.Add(new MessageDTO
                    {
                        UserId = senderId,
                        //ReceiverId = recipientId,
                        Content = message
                    });
                    InvokeAsync(StateHasChanged);
                });

                await hubConnection.StartAsync();

                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("scrollToBottom", "chatContainer");

                LoadingService.IsLoading = false;
            }
            else
            {
                await AlertService.ShowAlertAsync("Error", messageRespons.Message, "OK");
            }
        }
        catch (Exception ex)
        {

            throw;
        }
    }

    private async Task Send()
    {
        if (hubConnection != null)
        {
            //var formattedMessage = $"From {senderId}: {messageInput}";
            //messages.Add(messageInput);
            messageFromUser.MessagesDto.Add(new MessageDTO
            {
                UserId = senderId,
                //ReceiverId = recipientId,
                Content = messageInput
            });
            await hubConnection.SendAsync("SendMessageToClient", senderId, recipientId, messageInput, int.Parse(conversationId));
        }
    }

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task<string> GetToken()
    {
        var token = await SecureStorage.GetAsync("accessToken");
        return token;
    }

    private async Task NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task NavigateToChatRooms()
    {
        NavManager.NavigateTo("/chatrooms");
    }
}
