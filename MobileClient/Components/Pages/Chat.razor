@page "/chat/{senderId}/{recipientId}"
@using Application.DTO
@using Application.DTO.Response
@using Microsoft.AspNetCore.SignalR.Client
@using MobileClient.Services.Chat
@inject IChatService ChatService
@inject NavigationManager NavManager
@implements IAsyncDisposable

<nav class="navbar fixed-top navbar-light bg-light">
    <div class="container-fluid">
        <div class="d-flex align-items-center" @onclick="() => NavigateToUserProfile(messageFromUser.Id)">
            <img src="@messageFromUser.ProfilePictureString" alt="Profile picture" style="width: 50px; height: 50px;" class="me-2 rounded-circle" />
            <p class="mb-0" style="cursor: default;">@messageFromUser.Name</p>
        </div>
    </div>
</nav>

