@page "/chat/{senderId}/{recipientId}/{conversationId}"
@using Application.DTO
@using Application.DTO.Request
@using Application.DTO.Response
@using Microsoft.AspNetCore.SignalR.Client
@using MobileClient.Services.Alert
@using MobileClient.Services.Chat
@using MobileClient.Services.LoadingService
@inject IJSRuntime JS
@inject IChatService ChatService
@inject NavigationManager NavManager
@implements IAsyncDisposable
@inject IAlertService AlertService
@inject LoadingService LoadingService
@layout MobileClient.Components.Layout.ChatLayout

<div class="container-fluid vh-100 d-flex flex-column p-0">
    <nav class="navbar navbar-light bg-light flex-shrink-0">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                @if (IsSuccess)
                {
                    <span class="bi bi-arrow-left fs-3" @onclick="NavigateToChatRooms"></span>
                    <img src="@messageFromUser.ProfilePictureString"
                         style="width:50px;height:50px"
                         class="me-2 rounded-circle" />
                    <p class="mb-0">@messageFromUser.Name</p>
                }
            </div>
        </div>
    </nav>
    <div id="chatContainer"
         class="flex-grow-1 overflow-auto bg-light px-3">
        @foreach (var message in messageFromUser.MessagesDto)
        {
            if (message.UserId == senderId)
            {
                <div class="d-flex mb-2">
                    <div class="ms-auto p-2 rounded text-white shadow-sm"
                         style="background-color:#512bdf">
                        @message.Content
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex mb-2">
                    <div class="p-2 rounded bg-white shadow-sm">
                        @message.Content
                    </div>
                </div>
            }
        }
    </div>
    @if (!conversationBlocked)
    {
        <div class="bg-light p-2 flex-shrink-0 border-top">
            <div class="input-group">
                <input class="form-control"
                       placeholder="Type a message..."
                       @bind="messageInput" />
                <button class="btn btn-primary"
                        @onclick="Send"
                        disabled="@(IsConnected == false)">
                    Send
                </button>
            </div>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<string> messages = new();
    private MessageResponse messageFromUser = new();
    private PageSettingsRequest pageSettings = new();
    private string? userInput;
    private string? messageInput;
    private bool conversationBlocked;
    private bool IsSuccess;
    private bool isLoading = false;
    private bool hasMoreData = true;
    private IJSObjectReference? module;
    //private DotNetObjectReference<YourComponent>? dotNetRef;
    [Parameter]
    public string? senderId { get; set; }
    [Parameter]
    public string? recipientId { get; set; }
    [Parameter]
    public string? conversationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            LoadingService.IsLoading = true;

            var messageRespons = await ChatService.GetMessages(recipientId, int.Parse(conversationId), pageSettings);
            if (messageRespons.IsSuccess)
            {
                IsSuccess = messageRespons.IsSuccess;

                messageFromUser = messageRespons;

                conversationBlocked = messageRespons.ConversationBlocked;
                var oldMessages = messageRespons.MessagesDto;

                foreach (var message in oldMessages)
                {
                    messages.Add(message.Content);
                }

                //var url1 = "http://192.168.100.19:4321/socialnetwork/chathub";
                var url2 = "";
                if (DeviceInfo.Platform == DevicePlatform.Android)
                    url2 = "http://10.0.2.2:5209/chathub";
                else
                    url2 = "https://localhost:7098/chathub";

                hubConnection = new HubConnectionBuilder().WithUrl(NavManager.ToAbsoluteUri(url2), async options =>
                {
                    options.AccessTokenProvider = async() => await GetToken();
                }).WithAutomaticReconnect().Build();

                hubConnection.On<string, string>("ReceiveClientMessage", async (senderId, message) =>
                {
                    messageFromUser.MessagesDto.Add(new MessageDTO
                    {
                        UserId = senderId,
                        Content = message
                    });
                    await InvokeAsync(StateHasChanged);
                    await JS.InvokeVoidAsync("scrollToBottom", "chatContainer");
                });

                await hubConnection.StartAsync();

                await InvokeAsync(StateHasChanged);
                await JS.InvokeVoidAsync("scrollToBottom", "chatContainer");

                LoadingService.IsLoading = false;
            }
            else
            {
                await AlertService.ShowAlertAsync("Error", messageRespons.Message, "OK");
            }
        }
        catch (Exception ex)
        {

            throw;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollTop", "chatContainer", "LoadOlderMessages", DotNetObjectReference.Create(this));
        }
    }

    private async Task Send()
    {
        if (hubConnection != null)
        {
            messageFromUser.MessagesDto.Add(new MessageDTO
            {
                UserId = senderId,
                Content = messageInput
            });
            await hubConnection.SendAsync("SendMessageToClient", senderId, recipientId, messageInput, int.Parse(conversationId));
            messageInput = string.Empty;
            await InvokeAsync(StateHasChanged);
            await JS.InvokeVoidAsync("scrollToBottom", "chatContainer");
        }
    }

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    [JSInvokable]
    public async Task LoadOlderMessages()
    {
        if (isLoading || !hasMoreData)
            return;

        isLoading = true;

        // Dohvat trenutne visine scrolla prije nego se učitaju priješnje poruke
        var previousHeight = await module.InvokeAsync<double>("getScrollHeight", "chatContainer");

        pageSettings.PageNumber++;

        var response = await ChatService.GetMessages(
            recipientId,
            int.Parse(conversationId),
            pageSettings);

        if (response.MessagesDto != null && response.MessagesDto.Any())
        {
            // Prepend messages
            messageFromUser.MessagesDto.InsertRange(0, response.MessagesDto);
        }
        else
        {
            hasMoreData = false;
        }

        isLoading = false;
        StateHasChanged();

        //  Vračanje pozicije scrolla (prevencija skakanja na vrh nakon dohvata starih poruka)
        await module.InvokeVoidAsync("restoreScrollPosition", "chatContainer", previousHeight);
    }

    private async Task<string> GetToken()
    {
        var token = await SecureStorage.GetAsync("accessToken");
        return token;
    }

    private async Task NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }

    private async Task NavigateToChatRooms()
    {
        NavManager.NavigateTo("/chatrooms");
    }
}
