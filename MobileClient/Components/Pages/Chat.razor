<div class="vh-100 d-flex flex-column">
    <div class="flex-grow-1 overflow-auto p-3 bg-light pb-5">
        @foreach (var message in messageFromUser.MessagesDto)
        {
            if (message.SenderId == senderId)
            {
                <div class="d-flex mb-2">
                    <div style="background-color: #512bdf; color: white" class="d-inline-block p-2 rounded shadow-sm w-auto ms-auto">
                        @message.Content
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex mb-2">
                    <div class="d-inline-block p-2 rounded bg-white shadow-sm w-auto">
                        @message.Content
                    </div>
                </div>
            }
        }
    </div>

    @if (!conversationBlocked)
    {
        <div class="fixed-bottom bg-light p-2">
            <div class="input-group">
                <input class="form-control"
                       placeholder="Type a message..."
                       @bind="messageInput" />

                <button class="btn btn-primary"
                        @onclick="Send"
                        disabled="@(IsConnected == false)">
                    Send
                </button>
            </div>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<string> messages = new();
    private UserBriefDetailsDTO userToChat = new();
    private MessageResponse messageFromUser = new();
    private string? userInput;
    private string? messageInput;
    private bool conversationBlocked;
    [Parameter]
    public string? senderId { get; set; }
    [Parameter]
    public string? recipientId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var messageRespons = await ChatService.GetMessages(recipientId);
            messageFromUser = messageRespons;
            userToChat.Name = messageRespons.Name;
            userToChat.ProfilePictureString = messageRespons.ProfilePictureString;

            conversationBlocked = messageRespons.ConversationBlocked;
            var oldDessages = messageRespons.MessagesDto;

            foreach (var message in oldDessages)
            {
                messages.Add(message.Content);
            }

            var url1 = "http://192.168.100.19:4321/socialnetwork/chathub";
            var url2 = "";
            if (DeviceInfo.Platform == DevicePlatform.Android)
                url2 = "http://10.0.2.2:5209/chathub";
            else
                url2 = "https://localhost:7098/chathub";

            hubConnection = new HubConnectionBuilder().WithUrl(NavManager.ToAbsoluteUri(url2), async options =>
            {
                options.AccessTokenProvider = async() => await GetToken();
            }).WithAutomaticReconnect().Build();

            hubConnection.On<string, string>("ReceiveClientMessage", (senderId, message) =>
            {
                //var formattedMessage = $"From {senderId}: {message}";
                //var formattedMessage = $"{message}";
                //messages.Add(message);
                messageFromUser.MessagesDto.Add(new MessageDTO
                {
                    SenderId = senderId,
                    ReceiverId = recipientId,
                    Content = message
                });
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            
            throw;
        }
    }

    private async Task Send()
    {
        if (hubConnection != null)
        {
            //var formattedMessage = $"From {senderId}: {messageInput}";
            //messages.Add(messageInput);
            messageFromUser.MessagesDto.Add(new MessageDTO
            {
                SenderId = senderId,
                ReceiverId = recipientId,
                Content = messageInput
            });
            await hubConnection.SendAsync("SendMessageToClient", senderId, recipientId, messageInput);
        }
    }

    private bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
            await hubConnection.DisposeAsync();
    }

    private async Task<string> GetToken()
    {
        var token = await SecureStorage.GetAsync("accessToken");
        return token;
    }
    
    private void NavigateToUserProfile(string userId)
    {
        NavManager.NavigateTo($"/profile/user/{userId}");
    }
}
