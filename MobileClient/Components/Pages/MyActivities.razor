@page "/myactivities"
@using Application.DTO.Response
@using Application.Exceptions
@using MobileClient.Services.Activity
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject IActivityService ActivityService
@inject NavigationManager NavManager
@inject IAlertService AlertService
@inject LoadingService LoadingService

@if (activities == null || !activities.MyActivities.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-x fs-1"></i>
        <p class="mt-2">No activities available</p>
    </div>
}

@if (activities != null)
{
    <div class="container py-2">
        @foreach (var activity in activities.MyActivities)
        {
            <div class="card mb-3">
                <div class="card-body pt-3">
                    <p class="mb-2 fs-6">@activity.Description</p>
                    <span class="badge bg-secondary mb-3">@activity.ActivityCategory</span>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary px-3" style="background-color: green;" @onclick="() => AcceptedActivity(activity.Id)">
                            <i class="bi bi-person"></i> Accepted: @activity.AcceptedCount
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private MyActivityResponse? activities;

    protected override async Task OnInitializedAsync()
    {
        var response = await ActivityService.MyActivities();
        if (response.IsSuccess)
            activities = response;
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");
    }

    private void AcceptedActivity(int activityId)
    {
        NavManager.NavigateTo($"/myactivities/accepted/{activityId.ToString()}");
    }
}
