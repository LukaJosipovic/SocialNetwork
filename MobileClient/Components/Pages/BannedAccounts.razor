@page "/bannedaccounts"
@using Application.DTO
@using Application.DTO.Request
@using Application.DTO.Response
@using MobileClient.Services.Account
@inject IAccountService AccountService
@inject NavigationManager NavManager
@using MobileClient.Services.Alert
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService
@inject IAlertService AlertService
@inject IJSRuntime JS

<div class="pt-4">
    <div class="input-group mb-3" style="width: 90%; margin: 0 auto;">
        <input type="text" value="@email" @oninput="OnSearchChange" class="form-control" placeholder="email">
    </div>
</div>

<div id="chatContainer" class="container py-2 overflow-auto" style="height: 89vh; margin-top: 20px;">
    @if (accounts.Any())
    {
        @foreach (var account in accounts)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center flex-grow-1" @onclick="() => NavigateToProfile(account.UserId)" style="cursor:pointer;">
                            @if (account.ProfilePictureString != null)
                            {
                                <img src="@account.ProfilePictureString" class="rounded-circle me-3" style="width:48px; height:48px; object-fit:cover;" />
                            }
                            <div>
                                <div class="fw-semibold">
                                    @account.Name
                                </div>
                                <small class="text-muted">
                                    @account.Email
                                </small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-chat-dots fs-1"></i>
            <p class="mt-2 mb-0">There are currently no banned accounts</p>
        </div>
    }
</div>

@code {
    private string email;
    private BannedAccountResponse? account = null;
    private List<BannedAccountDTO> accounts = new List<BannedAccountDTO>();
    private PageSettingsRequest pageSettings = new();
    private bool hasMoreData = true;
    private CancellationTokenSource? searchCancellationTokenSource;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollEnd", "chatContainer", "LoadMoreUsers", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            if (!hasMoreData)
                return;

            var response = await AccountService.GetBannedAccounts(pageSettings);
            if (response.IsSuccess && response.BannedAccounts != null && response.BannedAccounts.Any())
            {
                accounts.AddRange(response.BannedAccounts);
                pageSettings.PageNumber++;
            }
            else if (response.IsSuccess == false)
            {
                await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
            }
            else
            {
                hasMoreData = false;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            return;
        }
    }

    [JSInvokable]
    public async Task LoadMoreUsers()
    {
        await LoadUsers();
    }

    private async Task OnSearchChange(ChangeEventArgs e)
    {
        email = e.Value?.ToString();

        searchCancellationTokenSource?.Cancel();
        searchCancellationTokenSource?.Dispose();

        searchCancellationTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, searchCancellationTokenSource.Token);

            await StartSearch();
        }
        catch (TaskCanceledException)
        {
            // Ignore cancelled searches
        }
    }

    private async Task StartSearch()
    {
        pageSettings.PageNumber = 1;
        accounts.Clear();
        hasMoreData = true;

        pageSettings.SearchTerm = email;

        if (string.IsNullOrWhiteSpace(email))
            pageSettings.SearchTerm = null;

        await LoadUsers();
    }

    private void NavigateToProfile(string userId)
    {
        NavManager.NavigateTo($"/bannedprofile/user/{userId}");
    }
}
