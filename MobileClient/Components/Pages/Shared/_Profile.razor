@using Application.DTO.Response
@inject NavigationManager NavManager

<div class="text-center">

    @if (!string.IsNullOrEmpty(profile.ProfilePictureString))
    {
        <img src="@profile.ProfilePictureString"
             alt="Profile picture"
             class="rounded-circle mb-2"
             style="width: 150px; height: 150px; object-fit: cover;" />
    }

    <h3 class="mt-2">@profile.Name</h3>
    <p>@profile.Description</p>

    @if (profile.PostDTO != null && profile.PostDTO.Count > 0)
    {
        <div class="row g-1 mt-3">
            @foreach (var post in profile.PostDTO)
            {
                <div class="col-4">
                    <img src="@post.ImageUrl"
                         class="img-fluid"
                         style="cursor: pointer; aspect-ratio: 1 / 1; object-fit: cover;"
                         @onclick="() => NavigateToPostDetails(post.PostID)" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public UserProfileRespons profile { get; set; }
    private string? profileImage;

    private void NavigateToPostDetails(int postId)
    {
        NavManager.NavigateTo($"/profile/{postId}");
    }
}
