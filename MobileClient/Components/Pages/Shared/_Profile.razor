@using Application.DTO.Response
@inject NavigationManager NavManager

<style>
    .profile-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px 12px;
    }

    .profile-picture {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
    }

    .profile-name {
        margin-top: 12px;
        margin-bottom: 0;
        font-weight: 700;
    }

    .profile-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 18px auto;
    }

    .profile-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 100px;
    }

    .profile-stat-number {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .profile-stat-label {
        font-size: 0.85rem;
        color: #777;
        margin-top: 3px;
    }

    .profile-stat-divider {
        width: 1px;
        height: 42px;
        background-color: #d0d0d0;
        margin: 0 18px;
    }

    .profile-description {
        max-width: 450px;
        margin: 10px auto 0;
        color: #555;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .post-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        cursor: pointer;
        display: block;
    }

    .activities-section {
        max-width: 450px;
        margin: 20px auto 0;
        text-align: left;
    }

    .activities-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .activities-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
    }

    .activity-chip {
        display: inline-flex;
        align-items: center;
        padding: 7px 13px;
        border-radius: 20px;
        background-color: #f1f3f5;
        color: #444;
        font-size: 0.85rem;
        font-weight: 500;
        border: 1px solid #e1e3e5;
    }
</style>

<div class="profile-container text-center">

    @if (!string.IsNullOrEmpty(profile.ProfilePictureString))
    {
        <img src="@profile.ProfilePictureString"
             alt="Profile picture"
             class="profile-picture" />
    }

    <h3 class="profile-name">@profile.Name</h3>

    <div class="profile-stats">
        <div class="profile-stat" @onclick="NavigateToMatches">
            <span class="profile-stat-number">@profile.MatchCount</span>
            <span class="profile-stat-label">Matches</span>
        </div>

        <div class="profile-stat-divider"></div>

        <div class="profile-stat" @onclick="NavigateToFriends">
            <span class="profile-stat-number">@profile.FriendCount</span>
            <span class="profile-stat-label">Friends</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(profile.Description))
    {
        <p class="profile-description">@profile.Description</p>
    }

    @if (profile.Activities != null && profile.Activities.Count > 0)
    {
        <div class="activities-section">
            <div class="activities-list">
                @foreach (var activity in profile.Activities)
                {
                    <span class="activity-chip">
                        @activity
                    </span>
                }
            </div>
        </div>
    }

    @if (profile.PostDTO != null && profile.PostDTO.Count > 0)
    {
        <div class="row g-1 mt-3">
            @foreach (var post in profile.PostDTO)
            {
                <div class="col-4">
                    <img src="@post.ImageUrl"
                         class="img-fluid post-image"
                         @onclick="() => NavigateToPostDetails(post.PostID)" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public UserProfileRespons profile { get; set; }
    private string? profileImage;
    [Parameter]
    public string? UserId { get; set; }

    private void NavigateToPostDetails(int postId)
    {
        NavManager.NavigateTo($"/profile/{postId}");
    }

    private void NavigateToMatches()
    {
        if (UserId == null)
            NavManager.NavigateTo($"/matches");
        else
            NavManager.NavigateTo($"/matches/{UserId}");
    }

    private void NavigateToFriends()
    {
        if (UserId == null)
            NavManager.NavigateTo($"/friends");
        else
            NavManager.NavigateTo($"/friends/{UserId}");
    }
}
