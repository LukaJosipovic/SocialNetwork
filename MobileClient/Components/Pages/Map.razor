@inject IJSRuntime JS
@implements IAsyncDisposable
@inject IAlertService AlertService
@page "/map"
@using Application.DTO
@using MobileClient.Components.Layout
@using MobileClient.Services.Alert
@using Microsoft.AspNetCore.SignalR.Client
@using MobileClient.Services.Location
@using System.Text.Json
@using MobileClient.Helper;
@inject ILocationService LocationService
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService

<div id="map" style="height: calc(100vh - 3.5rem);"></div>

@code {
    private IJSObjectReference? module;
    //private string? result;
    //private Location? location;
    //private CancellationTokenSource _cancelTokenSource;
    //private bool _isCheckingLocation;
    //private readonly HashSet<string> _knownUsers = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Permissions.CheckStatusAsync<Permissions.LocationAlways>();

            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.LocationAlways>();
            }
            if (status == PermissionStatus.Granted)
            {
                await LoadMap();
            }
        }
        catch (Exception ex)
        {
            
        }
    }

    public async Task LoadMap()
    {
        try
        {
            LoadingService.IsLoading = true;

            //_isCheckingLocation = true;

            //GeolocationRequest request = new GeolocationRequest(GeolocationAccuracy.Best, TimeSpan.FromSeconds(10));

            //_cancelTokenSource = new CancellationTokenSource();

            var location = await LocationHelper.GetCurrentLocation();

            var usersLocatoins = await LocationService.GetUsersLocations();

            if (location != null && module == null)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./leaflet.js");
            }

            if (module != null && location != null)
            {
                //result = await module.InvokeAsync<string>("load_map", location?.Latitude, location?.Longitude);
                await module.InvokeAsync<string>("load_map", location?.Latitude, location?.Longitude);
                var userLocationsJson = JsonSerializer.Serialize(usersLocatoins);
                await module.InvokeVoidAsync("add_user_markers", userLocationsJson);
            }
            LoadingService.IsLoading = false;
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", "Something went wrong", "OK");
        }
        // finally
        // {
        //     _isCheckingLocation = false;
        // }
    }

    // public void CancelRequest()
    // {
    //     if (_isCheckingLocation && _cancelTokenSource != null && _cancelTokenSource.IsCancellationRequested == false)
    //         _cancelTokenSource.Cancel();
    // }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch
            {
                // ignore errors on cleanup
            }
        }
    }
}
