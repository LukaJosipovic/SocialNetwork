<div class="container py-3">
    <div class="card mb-3">
        <div class="card-body text-center">
            @if (!string.IsNullOrEmpty(ImagePreview))
            {
                <img src="@ImagePreview"
                     class="rounded-circle mb-3"
                     style="width:120px; height:120px; object-fit:cover;" />
            }

            <InputFile OnChange="LoadImage" class="form-control mb-2" />

            <button type="button"
                    class="btn btn-primary w-100"
                    @onclick="ChangeProfilePicture">
                Change Profile Picture
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Username</label>
            <input type="text"
                   class="form-control mb-2"
                   @bind="username" />

            <button type="button"
                    class="btn btn-success w-100"
                    @onclick="UpdateUsername">
                Update Username
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Activities</label>

            <select multiple
                    class="form-select mb-2"
                    size="5"
                    @onchange="OnSelectedCategoriesChanged">
                @foreach (var category in Enum.GetValues<ActivityCategory>())
                {
                    <option value="@category.ToString()"
                            selected="@SelectedCategories.Contains(category)">
                        @GetEnumDescription(category)
                    </option>
                }
            </select>

            <button class="btn btn-primary w-100"
                    @onclick="SubmitCategories">
                Change Activities
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <label class="form-label fw-semibold mb-2">Preferences</label>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="GhostMode"
                       @bind="IsGhostMode"
                       @bind:after="OnGhostModeChanged">
                <label class="form-check-label" for="GhostMode">
                    Ghost mode
                </label>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="DoNotDisturb"
                       @onchange="OnDoNotDisturbModeChanged">
                <label class="form-check-label" for="DoNotDisturb">
                    Do not disturb
                </label>
            </div>
        </div>
    </div>

</div>

@code {
    private string? ImagePreview;
    private byte[]? buffer;
    private string username;
    private List<ActivityCategory> SelectedCategories { get; set; } = new();
    private bool IsGhostMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.GetUserById();
        username = response.Name;

        if (response.ProfilePicture != null)    
            ImagePreview = $"data:image;base64,{Convert.ToBase64String(response.ProfilePicture)}";

        var ghostModeValue = await SecureStorage.GetAsync("ghostMode");
        if (!string.IsNullOrEmpty(ghostModeValue) && bool.TryParse(ghostModeValue, out var ghostMode))
        {
            IsGhostMode = ghostMode;
        }

        LoadingService.IsLoading = false;
    }

    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024).ReadAsync(buffer);
            // ImagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            ImagePreview = $"data:image;base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync($"Error", "Error loading image", "OK");
        }
    }

    private async Task ChangeProfilePicture()
    {
        if (buffer != null)
        {
            LoadingService.IsLoading = true;

            var request = new ChangeProfilePictureRequest
            {
                ImageData = buffer
            };
            var response = await AccountService.ChangeProfilePicture(request);

            if (response.IsSuccess && !IsGhostMode)
            {
                // Microsoft.Maui.Devices.Sensors.Location location = new Microsoft.Maui.Devices.Sensors.Location
                // {
                //     Latitude = 45.83111,
                //     Longitude = 16.11639
                // };

                // if (location != null)
                //     await LocationService.AddLocation(location.Latitude, location.Longitude);
                LoadingService.IsLoading = false;
                await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
            }
            else if (response.IsSuccess && IsGhostMode)
            {
                LoadingService.IsLoading = false;
                await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
            }
            else
            {
                LoadingService.IsLoading = false;
                await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
            }
        }
    }

    private async Task UpdateUsername()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.UpdateUsername(username);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");

        LoadingService.IsLoading = false;
    }

    private void OnSelectedCategoriesChanged(ChangeEventArgs e)
    {
        List<ActivityCategory> selectedCategories = new();

        var selectedOptions = (e.Value as IEnumerable<string>) ?? Enumerable.Empty<string>();

        foreach (var option in selectedOptions)
        {
            if (Enum.TryParse<ActivityCategory>(option, out var result))
            {
                selectedCategories.Add(result);
            }
        }
        SelectedCategories = selectedCategories;
    }

    private async Task SubmitCategories()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.ChangeActivities(SelectedCategories);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");

        LoadingService.IsLoading = false;
    }

    private string GetEnumDescription(ActivityCategory category)
    {
        return category switch
        {
            ActivityCategory.FoodAndDrink => "Food & Drink",
            ActivityCategory.SportsAndFitness => "Sports & Fitness",
            ActivityCategory.ArtsAndCulture => "Arts & Culture",
            ActivityCategory.EntertainmentAndNightlife => "Entertainment & Nightlife",
            ActivityCategory.LearningAndHobbies => "Learning & Hobbies",
            ActivityCategory.OutdoorsAndNature => "Outdoors & Nature",
            ActivityCategory.VolunteeringAndCauses => "Volunteering & Causes",
            ActivityCategory.GamesAndActivities => "Games & Activities",
            ActivityCategory.TravelAndExploration => "Travel & Exploration",
            ActivityCategory.ChillAndRelaxation => "Chill & Relaxation",
            _ => category.ToString()
        };
    }

    private async Task OnGhostModeChanged()//ChangeEventArgs e)
    {
        //bool gostMode = (bool)e.Value;
        bool gostMode = IsGhostMode;

        await SecureStorage.SetAsync("ghostMode", gostMode.ToString());

        var response = await AccountService.GhostMode(gostMode);

        if (response.IsSuccess && gostMode)
        {
            var result = await LocationTracker.Stop();
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        }
        else if (response.IsSuccess && !gostMode)
        {
            await LocationTracker.StartAsync();
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        }
        else
        {    
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");
        }
    }

    private async Task OnDoNotDisturbModeChanged(ChangeEventArgs e)
    {
        var response = await AccountService.DoNotDisturb((bool)e.Value);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");
    }
}
