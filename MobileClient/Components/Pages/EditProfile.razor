@inject IAlertService AlertService
@inject IAccountService AccountService
@page "/editmyprofile"
@using Application.DTO.Request
@using Application.DTO.Response
@using Application.Enum
@using MobileClient.BackgroundTask.Location
@using MobileClient.Helper
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.Location
@inject ILocationService LocationService
@using MobileClient.Services.LoadingService
@inject LoadingService LoadingService

<div class="container py-3">
    <div class="card mb-3">
        <div class="card-body text-center">
            @if (!string.IsNullOrEmpty(ImagePreview))
            {
                <img src="@ImagePreview"
                     class="rounded-circle mb-3"
                     style="width:120px; height:120px; object-fit:cover;" />
            }

            <InputFile OnChange="LoadImage" class="form-control mb-2" />

            <button type="button"
                    class="btn btn-primary w-100"
                    @onclick="ChangeProfilePicture">
                Change Profile Picture
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Username</label>
            <input type="text"
                   class="form-control mb-2"
                   maxlength="255"
                   @bind="username" 
                   @bind:event="oninput"
                   @bind:after="ValidateInput"/>

            @if (!string.IsNullOrEmpty(usernameValidationMessage))
            {
                <div class="text-danger mb-2">
                    @usernameValidationMessage
                </div>
            }
            <button type="button"
                    class="btn btn-success w-100"
                    @onclick="UpdateUsername">
                Update Username
            </button>
        </div>
    </div>

    @* <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Select activity categories</label>

            <select multiple
                    class="form-select mb-2"
                    size="5"
                    @onchange="OnSelectedCategoriesChanged">
                @foreach (var category in Enum.GetValues<ActivityCategory>())
                {
                    <option value="@category.ToString()"
                            selected="@SelectedCategories.Contains(category)">
                        @EnumHelper.GetEnumDescription(category)
                    </option>
                }
            </select>

            <button class="btn btn-primary w-100"
                    @onclick="SubmitCategories">
                Change Activities
            </button>
        </div>
    </div> *@
    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">Select activity categories</label>

            <div class="border rounded p-2 mb-2" style="max-height: 200px; overflow-y: auto;">
                @foreach (var category in Enum.GetValues<ActivityCategory>())
                {
                    var isSelected = SelectedCategories.Contains(category);
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="@category"
                               checked="@isSelected"
                               @onchange="(e) => ToggleCategory(category, (bool)e.Value!)">
                        <label class="form-check-label" for="@category">
                            @EnumHelper.GetEnumDescription(category)
                        </label>
                    </div>
                }
            </div>

            <button class="btn btn-primary w-100" @onclick="SubmitCategories">
                Change Activities
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(categoriesValidationMessage))
    {
        <div class="text-danger mb-2">
            @categoriesValidationMessage
        </div>
    }

    <div class="card">
        <div class="card-body">
            <label class="form-label fw-semibold mb-2">Preferences</label>

            <div class="form-check form-switch mb-2">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="GhostMode"
                       checked="@IsGhostMode"
                       @onchange="OnGhostModeChanged">
                <label class="form-check-label" for="GhostMode">
                    Ghost mode
                </label>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input"
                       type="checkbox"
                       role="switch"
                       id="DoNotDisturb"
                       checked="@IsDoNotDisturbMode"
                       @onchange="OnDoNotDisturbModeChanged">
                <label class="form-check-label" for="DoNotDisturb">
                    Do not disturb
                </label>
            </div>
        </div>
    </div>

</div>

@code {
    private string? ImagePreview;
    private byte[]? buffer;
    private string username;
    private List<ActivityCategory> SelectedCategories { get; set; } = new();
    private bool IsGhostMode;
    private bool IsDoNotDisturbMode;
    private string? usernameValidationMessage;
    private string? categoriesValidationMessage;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.GetUserById();
        username = response.Name;

        if (response.ProfilePicture != null)    
            ImagePreview = $"data:image;base64,{Convert.ToBase64String(response.ProfilePicture)}";

        // var ghostModeValue = await SecureStorage.GetAsync("ghostMode");
        // if (!string.IsNullOrEmpty(ghostModeValue) && bool.TryParse(ghostModeValue, out var ghostMode))
        // {
        //     IsGhostMode = ghostMode;
        // }
        IsGhostMode = response.GhostMode;
        IsDoNotDisturbMode = response.DoNotDisturbMode;

        LoadingService.IsLoading = false;
    }

    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024).ReadAsync(buffer);
            ImagePreview = $"data:image;base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync($"Error", "Error loading image", "OK");
        }
    }

    private async Task ChangeProfilePicture()
    {
        if (buffer != null)
        {
            LoadingService.IsLoading = true;

            var request = new ChangeProfilePictureRequest
            {
                ImageData = buffer
            };
            var response = await AccountService.ChangeProfilePicture(request);

            if (response.IsSuccess)
            {
                LoadingService.IsLoading = false;
                await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
            }
            else
            {
                LoadingService.IsLoading = false;
                await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
            }
        }
    }

    private async Task UpdateUsername()
    {
        LoadingService.IsLoading = true;

        var response = await AccountService.UpdateUsername(username);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Ok", $"{response.Message}", "OK");
        else
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");

        LoadingService.IsLoading = false;
    }

    private void OnSelectedCategoriesChanged(ChangeEventArgs e)
    {
        List<ActivityCategory> selectedCategories = new();

        var selectedOptions = (e.Value as IEnumerable<string>) ?? Enumerable.Empty<string>();

        foreach (var option in selectedOptions)
        {
            if (Enum.TryParse<ActivityCategory>(option, out var result))
            {
                selectedCategories.Add(result);
            }
        }
        SelectedCategories = selectedCategories;
    }

    private void ToggleCategory(ActivityCategory category, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedCategories.Contains(category))
                SelectedCategories.Add(category);
        }
        else
        {
            SelectedCategories.Remove(category);
        }
    }

    private async Task SubmitCategories()
    {
        // if (SelectedCategories.Contains(ActivityCategory.SelectCategory))
        // {
        //     categoriesValidationMessage = "Please select a valid category";
        //     return;
        // }

        if (!SelectedCategories.Any())
        {
            categoriesValidationMessage = "Please select at least one category";
            return;
        }

    categoriesValidationMessage = null;

        LoadingService.IsLoading = true;

        var response = await AccountService.ChangeActivities(SelectedCategories);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");

        LoadingService.IsLoading = false;
    }

    private async Task OnGhostModeChanged(ChangeEventArgs eventArgs)
    {
        //bool gostMode = IsGhostMode;
        var gostMode = (bool)eventArgs.Value;
        // await SecureStorage.SetAsync("ghostMode", gostMode.ToString());

        var response = await AccountService.GhostMode(gostMode);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");
    }

    private async Task OnDoNotDisturbModeChanged(ChangeEventArgs eventArgs)
    {
        //bool doNotDisturbMode = IsDoNotDisturbMode;
        var doNotDisturbMode = (bool)eventArgs.Value;
        var response = await AccountService.DoNotDisturb(doNotDisturbMode);

        if (response.IsSuccess)
            await AlertService.ShowAlertAsync($"Success", response.Message, "OK");
        else
            await AlertService.ShowAlertAsync($"Error", response.Message, "OK");
    }

    private void ValidateInput()
    {
        if (username.Length > 255)
        {
            usernameValidationMessage = "Username cannot exceed 255 characters";
        }
        else if (string.IsNullOrWhiteSpace(username))
        {
            usernameValidationMessage = "Username is required";
        }
        else
        {
            usernameValidationMessage = null;
        }
    }
}
