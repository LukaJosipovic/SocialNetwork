@page "/blockedusers"
@using Application.DTO
@using Application.DTO.Request
@using Application.Exceptions
@using MobileClient.Services.Account
@using MobileClient.Services.Alert
@using MobileClient.Services.Chat
@using MobileClient.Services.LoadingService
@inject IChatService ChatService
@inject IAccountService AccountService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IAlertService AlertService
@inject LoadingService LoadingService

<div id="blockedUsersContainer" class="container py-2 overflow-auto" style="height: 89vh; margin-top: 20px;">
    @if (users != null && users.Any())
    {
        @foreach (var user in users)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center flex-grow-1">
                            @if (user.ProfilePictureString != null)
                            {
                                <img src="@user.ProfilePictureString" class="rounded-circle me-3" style="width:48px; height:48px; object-fit:cover;" />
                            }
                            <div>
                                <div class="fw-semibold">
                                    @user.Name
                                </div>
                            </div>
                        </div>
                        @* <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" @onclick="() => UnblockUser(user.Id)">
                            Unblock <i class="bi bi-unlock-fill me-1"></i>
                        </button> *@
                        <div class="dropdown">
                            <button class="btn btn-link p-0 m-0 border-0" type="button" id="iconMenuButton"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical fs-4"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="iconMenuButton">
                                <li><button class="dropdown-item" @onclick="() => UnblockUser(user.Id)">Unblock</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-chat-dots fs-1"></i>
            <p class="mt-2 mb-0">There are currently no blocked users</p>
        </div>
    }
</div>

@code {
    private List<UserBriefDetailsDTO>? users = new();
    private PageSettingsRequest pageSettings = new();
    private bool hasMoreData = true;

    protected override async Task OnInitializedAsync()
    {
        LoadingService.IsLoading = true;
        await LoadUsers();
        LoadingService.IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./infiniteScroll.js");
            await module.InvokeVoidAsync("checkDivScrollEnd", "blockedUsersContainer", "LoadMoreUsers", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadUsers()
    {
        var response = await AccountService.GetBlockedUsers(pageSettings);
        if (response != null && response.UserBriefDetails.Any())
        {
            users.AddRange(response.UserBriefDetails);
            pageSettings.PageNumber++;
        }
        else
        {
            hasMoreData = false;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task LoadMoreUsers()
    {
        await LoadUsers();
    }

    private async Task UnblockUser(string userId)
    {
        var response = await AccountService.UnblockUser(userId);

        if (response.IsSuccess)
        {
            users.RemoveAll(u => u.Id == userId);
            StateHasChanged();
        }
        else
        {
            await AlertService.ShowAlertAsync($"Error", $"{response.Message}", "OK");
        }
    }
}
